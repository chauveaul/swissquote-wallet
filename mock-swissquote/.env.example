# Copy to .env and fill in. Not committed (see .gitignore).
# This key is this server's custodial signer — the wallet app never sees it.
# Generate one with: node -e "console.log(require('viem/accounts').generatePrivateKey())"
CUSTODIAL_PRIVATE_KEY=

PORT=4001

# Bank staff token for /compliance/* (audit log, held deposits, reserves). Unset = those endpoints are off.
# COMPLIANCE_TOKEN=change-me

# Comma-separated addresses on the bank's own sanctions/denylist, on top of the
# Chainalysis on-chain oracle (OFAC SDN). Use this to demo a sanctions hit on a testnet.
# SANCTIONED_ADDRESSES=0x...

# Mainnet RPC for the Chainalysis sanctions oracle. Screening fails closed if it's unreachable.
# SANCTIONS_RPC_URL=https://ethereum-rpc.publicnode.com

# Domain in the EIP-4361 ownership challenge.
# SIWE_DOMAIN=wallet.swissquote.mock

# Session lifetime and the waiting period before the first withdrawal to a newly linked wallet.
# SESSION_TTL_MS=900000
# LINK_COOLDOWN_MS=0        # production: 86400000 (24 h)
