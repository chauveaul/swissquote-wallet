# Copy to .env and adjust. Not committed (see .gitignore).

# false (default): read real balances and broadcast real signed transactions.
# true: serve the design's demo balances/prices/activity and simulate broadcasting.
# Key generation, encryption, unlock and address derivation are always real either way.
EXPO_PUBLIC_DEMO_MODE=false

# Optional per-network RPC overrides; each falls back to the chain's public RPC.
# EXPO_PUBLIC_RPC_URL_ETH=
# EXPO_PUBLIC_RPC_URL_ARB=
# EXPO_PUBLIC_RPC_URL_OP=
# EXPO_PUBLIC_RPC_URL_BASE=
# EXPO_PUBLIC_RPC_URL_POL=
# EXPO_PUBLIC_RPC_URL_ARB_SEPOLIA=
# EXPO_PUBLIC_RPC_URL_OP_SEPOLIA=
# EXPO_PUBLIC_RPC_URL_BASE_SEPOLIA=
# EXPO_PUBLIC_RPC_URL_POL_AMOY=
EXPO_PUBLIC_RPC_URL_SEPOLIA=https://ethereum-sepolia-rpc.publicnode.com

# Gasless sends (EIP-7702 + ERC-4337 paymaster). Unset = always pay gas in ETH.
# {chainId} is substituted per network. In production point these at a Swissquote
# proxy that holds the provider key: anything EXPO_PUBLIC_ is shipped in the app.
# EXPO_PUBLIC_BUNDLER_URL=https://api.pimlico.io/v2/{chainId}/rpc?apikey=YOUR_KEY
# EXPO_PUBLIC_PAYMASTER_URL=            # defaults to EXPO_PUBLIC_BUNDLER_URL
# EXPO_PUBLIC_SPONSORSHIP_POLICY_ID=    # e.g. a Pimlico sponsorship policy (sp_…)

# Mock Swissquote server (see mock-swissquote/), default assumes `npm run
# swissquote:mock` on the same machine. Web goes through the Metro dev proxy
# instead (no CORS) unless this is set. Android emulator needs 10.0.2.2, not
# localhost; a physical device needs your machine's LAN IP.
# EXPO_PUBLIC_SWISSQUOTE_MOCK_URL=http://localhost:4001

# --- Sepolia CLI sandbox (npm run demo:eoa / demo:send). Not EXPO_PUBLIC_: never bundled into the app.
RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
# Testnet-only key printed by `npm run demo:eoa`; fund it from a faucet.
DEMO_PRIVATE_KEY=
# Optional: ERC-4337 bundler (e.g. Pimlico) for walletCore/account.ts, and Circle's Sepolia USDC.
# BUNDLER_URL=
# USDC_ADDRESS=
