# Copy to .env and adjust. Not committed (see .gitignore).

# false (default): read real balances and broadcast real signed transactions.
# true: serve the design's demo balances/prices/activity and simulate broadcasting.
# Key generation, encryption, unlock and address derivation are always real either way.
EXPO_PUBLIC_DEMO_MODE=false

# Optional per-network RPC overrides; each falls back to the chain's public RPC.
# EXPO_PUBLIC_RPC_URL_ETH=
# EXPO_PUBLIC_RPC_URL_ARB=
# EXPO_PUBLIC_RPC_URL_OP=
# EXPO_PUBLIC_RPC_URL_BASE=
# EXPO_PUBLIC_RPC_URL_POL=
EXPO_PUBLIC_RPC_URL_SEPOLIA=https://ethereum-sepolia-rpc.publicnode.com

# --- Sepolia CLI sandbox (npm run demo:eoa / demo:send). Not EXPO_PUBLIC_: never bundled into the app.
RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
# Testnet-only key printed by `npm run demo:eoa`; fund it from a faucet.
DEMO_PRIVATE_KEY=
# Optional: ERC-4337 bundler (e.g. Pimlico) for walletCore/account.ts, and Circle's Sepolia USDC.
# BUNDLER_URL=
# USDC_ADDRESS=
