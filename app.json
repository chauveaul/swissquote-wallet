{
  "expo": {
    "name": "Swissquote Wallet",
    "slug": "swissquote-wallet",
    "scheme": "sqwallet",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.swissquote.cryptowallet",
      "infoPlist": {
        "NSFaceIDUsageDescription": "Use biometrics to unlock your wallet and approve transactions.",
        "ITSAppUsesNonExemptEncryption": false,
        "NSCameraUsageDescription": "Scan QR codes to fill in wallet addresses."
      }
    },
    "android": {
      "package": "com.swissquote.cryptowallet",
      "allowBackup": false,
      "adaptiveIcon": {
        "backgroundColor": "#121212",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "bundler": "metro",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-status-bar",
      [
        "expo-secure-store",
        {
          "faceIDPermission": "Use biometrics to unlock your wallet and approve transactions.",
          "configureAndroidBackup": true
        }
      ],
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Use biometrics to unlock your wallet and approve transactions."
        }
      ],
      "expo-font",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#121212",
          "image": "./assets/splash-icon.png",
          "imageWidth": 120
        }
      ],
      "expo-sharing",
      [
        "expo-camera",
        {
          "cameraPermission": "Scan QR codes to fill in wallet addresses.",
          "recordAudioAndroid": false,
          "microphonePermission": false
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
